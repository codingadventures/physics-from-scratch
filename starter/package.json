{
  "name": "physics-from-scratch-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Starter project for Physics From Scratch: stubs, tests and demos for a 2D rigid body engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "vite",
    "demo:0": "vite --open '/?demo=0'",
    "demo:1": "vite --open '/?demo=1'",
    "demo:2": "vite --open '/?demo=2'",
    "demo:3": "vite --open '/?demo=3'",
    "demo:4": "vite --open '/?demo=4'",
    "demo:5": "vite --open '/?demo=5'",
    "demo:6": "vite --open '/?demo=6'",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "progress": "node scripts/progress.mjs",
    "test:given": "vitest run src test-helpers",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:given && node scripts/progress.mjs --expect-stubs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
