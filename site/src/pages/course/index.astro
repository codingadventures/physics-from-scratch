---
import Base from "../../layouts/Base.astro";
import { href, label, lessonsInOrder } from "../../lib/course";
const lessons = await lessonsInOrder();
---
<Base title="Course">
  <h1>Course</h1>
  <p class="meta">Short lessons, in order. Exercises are where you write code.</p>
  <ol class="index">
    {lessons.map((e) => (
      <li><a href={href(e.id)}>{label(e)}</a>{e.data.minutes ? <span class="meta"> · {e.data.minutes} min</span> : null}</li>
    ))}
  </ol>
</Base>
<style>
  .index { list-style: none; padding: 0; }
  .index li { padding: 6px 0; border-bottom: 1px solid var(--line); }
</style>
